PORT=8788
JARVIS_JWT_SECRET=change-me-min-32-characters-long!!
# Pin a stable server keypair (raw 32-byte Ed25519, base64).
# Required when SUPABASE_URL is set — boot will not generate keys.
# JARVIS_SERVER_PRIVATE_KEY=
# JARVIS_SERVER_PUBLIC_KEY=
ACCOUNTS_BASE_URL=https://accounts.envia.com
ACCOUNTS_SITE_ID=6a51478d752f0077b7d9b356
# Local HUD without a second process. Leave unset in Railway.
JARVIS_INLINE_WORKER=1
# OpenAI — unset keeps the regex planner.
JARVIS_MODEL_BASE_URL=https://api.openai.com/v1
# JARVIS_MODEL_API_KEY=
JARVIS_MODEL_NAME=gpt-4.1-mini
# Supabase control plane — unset keeps the in-memory store.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# 32-byte vault key (base64). Required when SUPABASE_URL is set.
# JARVIS_VAULT_KEY=
# JARVIS_VAULT_KEY_PREVIOUS=
# Optional OAuth apps. Unset keeps the fields path.
# JARVIS_OAUTH_SHOPIFY_CLIENT_ID=
# JARVIS_OAUTH_SHOPIFY_CLIENT_SECRET=
# JARVIS_OAUTH_GMAIL_CLIENT_ID=
# JARVIS_OAUTH_GMAIL_CLIENT_SECRET=
# JARVIS_OAUTH_SLACK_CLIENT_ID=
# JARVIS_OAUTH_SLACK_CLIENT_SECRET=
